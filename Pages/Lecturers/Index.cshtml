@page
@model ETechCollege.Pages.Lecturers.IndexModel
@{
    ViewData["Title"] = "Lecturer Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Lecturer Management</h2>
            <p class="text-muted mb-0">Manage lecturers and their specialisations.</p>
        </div>
        <div>
            <a asp-page="/Specialisations/Index" class="btn btn-outline-secondary me-2">Manage Specialisations</a>
            <a asp-page="/Lecturers/Create" class="btn btn-primary">Add New Lecturer</a>
        </div>
    </div>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Lecturers.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Lecturer Name</th>
                    <th>NIC</th>
                    <th>Department</th>
                    <th>Specialisations</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lec in Model.Lecturers)
                {
                    <tr>
                        <td>@lec.LecturerID</td>
                        <td>@lec.LecturerName</td>
                        <td>@lec.NIC</td>
                        <td>@lec.DepartmentName</td>
                        <td><span class="badge bg-info">@lec.SpecialisationCount</span></td>
                        <td>
                            <a asp-page="/Lecturers/Edit" asp-route-id="@lec.LecturerID"
                               class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@lec.LecturerID"
                                  class="d-inline"
                                  onsubmit="return confirm('Delete lecturer &quot;@lec.LecturerName.Replace("'", "\\'")&quot;?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No lecturers have been added yet. Click <strong>Add New Lecturer</strong> to get started.
        </div>
    }
</div>
