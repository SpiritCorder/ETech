@page
@model ETechCollege.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Student Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Student Management</h2>
            <p class="text-muted mb-0">Manage student registrations and exam results.</p>
        </div>
        <div>
            <a asp-page="/StudentExams/Index" class="btn btn-outline-secondary me-2">Exam Results</a>
            <a asp-page="/Students/Create" class="btn btn-primary">Register New Student</a>
        </div>
    </div>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Students.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>NIC</th>
                    <th>Type</th>
                    <th>Course</th>
                    <th>Batch</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model.Students)
                {
                    <tr>
                        <td>@student.StudentID</td>
                        <td>@student.StudentName</td>
                        <td>@student.NIC</td>
                        <td>@student.StudentType</td>
                        <td>@student.CourseName</td>
                        <td>@student.BatchName</td>
                        <td>
                            <a asp-page="/Students/Edit" asp-route-id="@student.StudentID"
                               class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@student.StudentID"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete the student &quot;@student.StudentName.Replace("'", "\\'")&quot;?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No students have been registered yet. Click <strong>Register New Student</strong> to get started.
        </div>
    }
</div>
