@page
@model ETechCollege.Pages.Exams.IndexModel
@{
    ViewData["Title"] = "Exam Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Exam Management</h2>
            <p class="text-muted mb-0">Manage exams.</p>
        </div>
        <a asp-page="/Exams/Create" class="btn btn-primary">Add New Exam</a>
    </div>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Exams.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Exam Number</th>
                    <th>Subject</th>
                    <th>Exam Date</th>
                    <th>Start Time</th>
                    <th>Location</th>
                    <th>Department</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exam in Model.Exams)
                {
                    <tr>
                        <td>@exam.ExamNumber</td>
                        <td>@exam.Subject</td>
                        <td>@exam.ExamDate.ToString("yyyy-MM-dd")</td>
                        <td>@exam.StartTime</td>
                        <td>@exam.Location</td>
                        <td>@exam.DepartmentName</td>
                        <td>
                            <a asp-page="/Exams/Edit" asp-route-id="@exam.ExamID"
                               class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@exam.ExamID"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete exam &quot;@exam.ExamNumber.Replace("'", "\\'")&quot;?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No exams have been added yet. Click <strong>Add New Exam</strong> to get started.
        </div>
    }
</div>
