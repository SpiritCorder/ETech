@page "{id:int}"
@model ETechCollege.Pages.Modules.EditModel
@{
    ViewData["Title"] = "Edit Module";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Edit Module</h2>
        <a asp-page="/Modules/Index" class="btn btn-outline-secondary">Back to Modules</a>
    </div>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="Module.ModuleID" />

                <div class="mb-3">
                    <label asp-for="Module.ModuleName" class="form-label"></label>
                    <input asp-for="Module.ModuleName" class="form-control" />
                    <span asp-validation-for="Module.ModuleName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Module.SubjectArea" class="form-label"></label>
                    <input asp-for="Module.SubjectArea" class="form-control" />
                    <span asp-validation-for="Module.SubjectArea" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="/Modules/Index" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
