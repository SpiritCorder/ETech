@page
@model ETechCollege.Pages.Classrooms.CreateModel
@{
    ViewData["Title"] = "Add Classroom";
}

<div class="container mt-4">
    <h2>Add Classroom</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Classroom.ClassroomNumber" class="form-label"></label>
                    <input asp-for="Classroom.ClassroomNumber" class="form-control" />
                    <span asp-validation-for="Classroom.ClassroomNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Classroom.Location" class="form-label"></label>
                    <input asp-for="Classroom.Location" class="form-control" />
                    <span asp-validation-for="Classroom.Location" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Classroom.Capacity" class="form-label"></label>
                    <input asp-for="Classroom.Capacity" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Classroom.Capacity" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Classrooms/Index" class="btn btn-secondary ms-2">Back to Classrooms</a>
            </form>
        </div>
    </div>
</div>
