@page
@model ETechCollege.Pages.Departments.IndexModel
@{
    ViewData["Title"] = "Department Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Department Management</h2>
            <p class="text-muted mb-0">Manage academic departments.</p>
        </div>
        <a asp-page="/Departments/Create" class="btn btn-primary">Add New Department</a>
    </div>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Departments.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Department Name</th>
                    <th>Contact Number</th>
                    <th>Email Address</th>
                    <th>Location</th>
                    <th style="width:160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model.Departments)
                {
                    <tr>
                        <td>@dept.DepartmentID</td>
                        <td>@dept.DepartmentName</td>
                        <td>@dept.ContactNumber</td>
                        <td>@dept.EmailAddress</td>
                        <td>@dept.Location</td>
                        <td>
                            <a asp-page="/Departments/Edit" asp-route-id="@dept.DepartmentID"
                               class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@dept.DepartmentID"
                                  class="d-inline"
                                  onsubmit="return confirm('Delete department &quot;@dept.DepartmentName.Replace("'", "\\'")&quot;?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No departments have been added yet. Click <strong>Add New Department</strong> to get started.
        </div>
    }
</div>
