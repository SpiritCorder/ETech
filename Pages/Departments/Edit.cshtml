@page "{id:int}"
@model ETechCollege.Pages.Departments.EditModel
@{
    ViewData["Title"] = "Edit Department";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Edit Department</h2>
        <a asp-page="/Departments/Index" class="btn btn-outline-secondary">Back to Departments</a>
    </div>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="Department.DepartmentID" />

                <div class="mb-3">
                    <label asp-for="Department.DepartmentName" class="form-label"></label>
                    <input asp-for="Department.DepartmentName" class="form-control" />
                    <span asp-validation-for="Department.DepartmentName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Department.ContactNumber" class="form-label"></label>
                    <input asp-for="Department.ContactNumber" class="form-control" />
                    <span asp-validation-for="Department.ContactNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Department.EmailAddress" class="form-label"></label>
                    <input asp-for="Department.EmailAddress" class="form-control" type="email" />
                    <span asp-validation-for="Department.EmailAddress" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Department.Location" class="form-label"></label>
                    <input asp-for="Department.Location" class="form-control" />
                    <span asp-validation-for="Department.Location" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="/Departments/Index" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
