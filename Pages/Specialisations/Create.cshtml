@page
@model ETechCollege.Pages.Specialisations.CreateModel
@{
    ViewData["Title"] = "Add Specialisation";
}

<div class="container mt-4">
    <h2>Add Specialisation</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Specialisation.SpecialisationName" class="form-label"></label>
                    <input asp-for="Specialisation.SpecialisationName" class="form-control" />
                    <span asp-validation-for="Specialisation.SpecialisationName" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Specialisations/Index" class="btn btn-secondary ms-2">Back to Specialisations</a>
            </form>
        </div>
    </div>
</div>
